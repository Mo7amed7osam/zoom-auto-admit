<Window x:Class="ZoomAutoAdmit.WindowsUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zoom Auto Admit" Height="720" Width="1080"
        MinHeight="560" MinWidth="860" Background="#F3F5F8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="4,0,4,14">
            <TextBlock Text="Zoom Auto Admit" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Windows meeting control" Foreground="#667085" />
        </StackPanel>
        <TabControl Grid.Row="1" Background="White" Padding="8" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Dashboard">
                <Grid Margin="12" DataContext="{Binding Dashboard}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Active sessions" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="Start Meeting" Command="{Binding DataContext.ShowStartMeetingCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="16,4,4,4" />
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#667085" VerticalAlignment="Center" Margin="10,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="#D0D5DD" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Last action" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LastAction}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Current operation" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CurrentOperation}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="2*" />
                            <DataGridTextColumn Header="Engine" Binding="{Binding EngineType}" Width="*" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
                            <DataGridTextColumn Header="Started" Binding="{Binding StartTime, StringFormat=g}" Width="2*" />
                            <DataGridTemplateColumn Header="Action" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Stop" Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Start Meeting">
                <Grid Margin="20" DataContext="{Binding StartMeeting}" MaxWidth="680" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Account" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                              DisplayMemberPath="DisplayName" />
                    <TextBlock Grid.Row="1" Text="Meeting URL" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MeetingUrl, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Meeting URL" ToolTip="Loaded from Accounts. Edit here for this launch only; save permanent changes in Accounts." />
                    <TextBlock Grid.Row="2" Text="Engine preference" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding EnginePreferences}" SelectedItem="{Binding EnginePreference}" />
                    <Button Grid.Row="3" Grid.Column="1" Content="Start Meeting" HorizontalAlignment="Left"
                            Command="{Binding StartCommand}" />
                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               Foreground="#475467" Margin="4,12" />
                </Grid>
            </TabItem>
            <TabItem Header="Accounts">
                <Grid Margin="12" DataContext="{Binding Accounts}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedAccount}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" Margin="0,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account ID" Binding="{Binding AccountId}" Width="*" />
                            <DataGridTextColumn Header="Zoom Email" Binding="{Binding ZoomEmail}" Width="2*" />
                            <DataGridTextColumn Header="Preferred" Binding="{Binding PreferredEngine}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Account details" FontSize="20" FontWeight="SemiBold" Margin="4,0,4,8" />
                        <TextBlock Text="Account ID"/><TextBox Text="{Binding AccountId, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Display name"/><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Zoom Email (used for account switching)"/><TextBox Text="{Binding ZoomEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Zoom Email" />
                        <TextBlock Text="Use the exact email shown in Zoom's saved accounts. No password is needed for switching." TextWrapping="Wrap" Foreground="#475467" Margin="4" />
                        <TextBlock Text="Default meeting URL (optional)" />
                        <TextBox Text="{Binding DefaultMeetingUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Default meeting URL" />
                        <TextBlock Text="Save this group's fixed Zoom link once. You can edit it and press Save whenever it changes."
                                   TextWrapping="Wrap" Foreground="#475467" Margin="4" />
                        <Expander Header="Advanced: optional secure credential reference" Margin="4">
                            <TextBox Text="{Binding CredentialReference, UpdateSourceTrigger=PropertyChanged}" />
                        </Expander>
                        <TextBlock Text="Preferred engine"/>
                        <ComboBox ItemsSource="{Binding EnginePreferences}" SelectedItem="{Binding PreferredEngine}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="New" Command="{Binding NewCommand}" />
                            <Button Content="Save" Command="{Binding SaveCommand}" />
                            <Button Content="Delete" Command="{Binding DeleteCommand}" />
                            <Button Content="Switch Account" Command="{Binding SwitchAccountCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#475467" TextWrapping="Wrap" Margin="4,10" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Schedules">
                <Grid Margin="12" DataContext="{Binding Schedules}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <TextBlock Text="Meeting schedules" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="16,4,4,4" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedSchedule}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="URL" Binding="{Binding MeetingUrl}" Width="2*" />
                            <DataGridTextColumn Header="Account" Binding="{Binding AccountId}" Width="*" />
                            <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat=HH\\:mm}" Width="*" />
                            <DataGridTextColumn Header="Days" Binding="{Binding Days}" Width="2*" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Schedule details" FontSize="20" FontWeight="SemiBold" Margin="4,0,4,8" />
                            <TextBlock Text="Name"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Meeting URL"/><TextBox Text="{Binding MeetingUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Account"/>
                            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="DisplayName" />
                            <TextBlock Text="Time (HH:mm)"/><TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Days" Margin="0,8,0,2" />
                            <WrapPanel>
                                <CheckBox Content="Mon" IsChecked="{Binding Monday}" Margin="5"/>
                                <CheckBox Content="Tue" IsChecked="{Binding Tuesday}" Margin="5"/>
                                <CheckBox Content="Wed" IsChecked="{Binding Wednesday}" Margin="5"/>
                                <CheckBox Content="Thu" IsChecked="{Binding Thursday}" Margin="5"/>
                                <CheckBox Content="Fri" IsChecked="{Binding Friday}" Margin="5"/>
                                <CheckBox Content="Sat" IsChecked="{Binding Saturday}" Margin="5"/>
                                <CheckBox Content="Sun" IsChecked="{Binding Sunday}" Margin="5"/>
                            </WrapPanel>
                            <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Margin="5,10" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="New" Command="{Binding NewCommand}" />
                                <Button Content="Save" Command="{Binding SaveCommand}" />
                                <Button Content="Delete" Command="{Binding DeleteCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#475467" TextWrapping="Wrap" Margin="4,10" />
                            <TextBlock Text="{Binding ExecutionStatus}" Foreground="#175CD3" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,4,4,10" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Logs">
                <Grid Margin="12" DataContext="{Binding Logs}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Runtime logs" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="Clear" Command="{Binding ClearCommand}" Margin="16,4,4,4" />
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" FontFamily="Consolas" Margin="0,10,0,0" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
